SUPABASE_URL=###
SUPABASE_KEY=###

# Spoonacular Food API — recipe retrieval (PRD FR-003).
# Server-side only: never expose to the client. Set in production with
# `wrangler secret put SPOONACULAR_API_KEY`. Consumed by src/lib/spoonacular.ts.
SPOONACULAR_API_KEY=###

# Guards the temporary spike endpoint (/api/spike/spoonacular) — removed when
# the spoonacular-retrieval-spike change closes. Any random string; requests
# must send it as the `x-spike-token` header.
SPIKE_TOKEN=###
