SUPABASE_URL=###
SUPABASE_KEY=###

# Supabase service_role key (project settings → API keys). Server-side only:
# bypasses RLS, never expose to the client. Set in production with
# `wrangler secret put SUPABASE_SERVICE_ROLE_KEY`. Consumed by src/lib/supabase-admin.ts.
SUPABASE_SERVICE_ROLE_KEY=###

# Spoonacular Food API — recipe retrieval (PRD FR-003).
# Server-side only: never expose to the client. Set in production with
# `wrangler secret put SPOONACULAR_API_KEY`. Consumed by src/lib/spoonacular.ts.
SPOONACULAR_API_KEY=###

# Playwright E2E — a real Supabase account used by e2e/auth.setup.ts to capture
# the authenticated session (playwright/.auth/user.json). Local/CI only.
E2E_USERNAME=###
E2E_PASSWORD=###
